{
  "name": "athena-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "firebase:status": "firebase login:list",
    "firebase:projects": "firebase projects:list",
    "firebase:functions": "firebase functions:list --project athena-3dd48",
    "firebase:secret": "firebase functions:secrets:set VENICE_API_KEY",
    "firebase:deploy": "firebase deploy --only functions",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check functions/index.js && node --test server/storage.test.js server/projectFiles.test.js server/imageGeneration.test.js functions/accessControl.test.js functions/ownerCenter.test.js src/easterEggs.test.js src/secureStorage.test.js && vite build"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase": "^12.17.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.27.0",
    "vite": "^7.2.2"
  }
}
